{
  "name": "Hiring plan with hiring pipeline and people-in-place targets",
  "description": "Custom hiring pipeline settled by people.record_arrangement alongside people.set_membership for headcount. Tracks both cumulative hires won in the pipeline (with weighted open-pipeline estimate) and point-in-time people in place.",
  "setupAt": "2026-09-01T00:00:00Z",
  "recordedAt": "2026-11-22T00:00:00Z",
  "steps": [
    {
      "key": "founder",
      "command": "parties.create",
      "input": { "partyId": "pty_founder", "name": "Maya Chen", "categories": ["founder"] }
    },
    {
      "key": "member-founder",
      "command": "people.set_membership",
      "input": {
        "membershipId": "mem_founder",
        "partyId": "pty_founder",
        "from": "2026-09-01",
        "sourceFactId": "hiring:member:founder",
        "evidence": [{ "kind": "other", "ref": "incorporation:founder" }]
      }
    },
    {
      "key": "hiring-pipeline",
      "command": "pipelines.define",
      "input": {
        "pipelineKey": "hiring",
        "name": "Hiring",
        "description": "Open roles and candidates",
        "settlementKinds": ["people_arrangement"],
        "stages": [
          { "key": "sourced", "name": "Sourced", "weightBps": 1000 },
          { "key": "interview", "name": "Interview", "weightBps": 4000 },
          { "key": "offer", "name": "Offer", "weightBps": 8000 }
        ]
      }
    },
    {
      "key": "msr-won-count",
      "command": "measures.define",
      "at": "2026-09-02T00:00:00Z",
      "input": {
        "definition": {
          "spec": "economico.measure/1",
          "report_schema": 1,
          "name": "Pursuits won in a pipeline",
          "description": "Count of pursuits won in a pipeline during the window, with a weighted open-pipeline count estimate to two decimal places.",
          "sql": "SELECT (SELECT count(*) FROM opportunities o JOIN events e ON e.event_id = o.won_event_id WHERE o.pipeline_key = :pipeline AND o.status = 'won' AND julianday(e.effective_at) >= julianday(:from) AND julianday(e.effective_at) < julianday(:through, '+1 day')) AS won, (SELECT (coalesce(sum(o.weight_bps), 0) + 50) / 100 FROM open_opportunities o WHERE o.pipeline_key = :pipeline AND o.expected_close_on BETWEEN :from AND :through) AS open_weighted",
          "columns": [
            { "name": "won", "unit": "number" },
            { "name": "open_weighted", "unit": "number", "decimals": 2, "estimate_for": "won" }
          ]
        }
      }
    },
    {
      "key": "msr-people",
      "command": "measures.define",
      "at": "2026-09-02T00:00:00Z",
      "input": {
        "definition": {
          "spec": "economico.measure/1",
          "report_schema": 1,
          "name": "People in place",
          "description": "Active team memberships on the books at the end of :through (ignores :from).",
          "sql": "SELECT count(DISTINCT r.party_id) AS people FROM people_records r WHERE r.kind = 'membership' AND r.current = 1 AND r.valid_from < r.valid_through AND julianday(r.valid_from) < julianday(:through, '+1 day') AND julianday(r.valid_through) >= julianday(:through, '+1 day')",
          "columns": [{ "name": "people", "unit": "number" }]
        }
      }
    },
    {
      "key": "can-dev",
      "command": "parties.create",
      "at": "2026-09-22T00:00:00Z",
      "input": { "partyId": "can_dev", "name": "Dev Patel" }
    },
    {
      "key": "opp-dev",
      "command": "opportunities.open",
      "at": "2026-09-22T00:00:00Z",
      "input": {
        "opportunityKey": "hire:dev",
        "name": "Senior engineer — Dev Patel",
        "partyId": "can_dev",
        "pipelineKey": "hiring",
        "kind": "new",
        "currency": "USD",
        "expectedValue": null,
        "expectedCloseOn": "2026-10-20",
        "stage": "interview",
        "labels": { "role": "Senior engineer" }
